<?xml version="1.0" encoding="utf-8"?>

<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <co.edu.unipiloto.ailearningmobile.AnimatedBackgroundView
        android:id="@+id/animatedBackground"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:overScrollMode="never">

        <LinearLayout
            android:id="@+id/main"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="22dp"
            android:paddingEnd="22dp"
            android:paddingTop="52dp"
            android:paddingBottom="32dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="NEXALEARN"
                android:textColor="#B9A7FF"
                android:textSize="14sp"
                android:textStyle="bold"
                android:letterSpacing="0.22"
                android:layout_marginStart="4dp"/>

            <TextView
                android:id="@+id/textBienvenida"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Bienvenido a NexaLearn"
                android:textColor="#FFFFFF"
                android:textSize="31sp"
                android:textStyle="bold"
                android:layout_marginTop="8dp"/>

            <TextView
                android:id="@+id/textUsuario"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Usuario"
                android:textColor="#C7C4D8"
                android:textSize="16sp"
                android:layout_marginTop="6dp"
                android:layout_marginBottom="24dp"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_nexa_card"
                android:elevation="14dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Tu espacio de aprendizaje"
                    android:textColor="#FFFFFF"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="6dp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Gestiona tus cursos, actividades y progreso desde un solo lugar."
                    android:textColor="#AFAAC4"
                    android:textSize="14sp"
                    android:layout_marginBottom="22dp"/>

                <Button
                    android:id="@+id/btnCursos"
                    android:layout_width="match_parent"
                    android:layout_height="58dp"
                    android:text="📚  Catálogo de cursos"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:gravity="center_vertical|start"
                    android:paddingStart="22dp"
                    android:background="@drawable/bg_button_nexa"
                    android:elevation="8dp"
                    android:layout_marginBottom="12dp"/>

                <Button
                    android:id="@+id/btnMisCursos"
                    android:layout_width="match_parent"
                    android:layout_height="58dp"
                    android:text="🎓  Mis cursos"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:gravity="center_vertical|start"
                    android:paddingStart="22dp"
                    android:background="@drawable/bg_button_nexa_secondary"
                    android:elevation="6dp"
                    android:layout_marginBottom="12dp"
                    android:visibility="gone"/>

                <Button
                    android:id="@+id/btnCentroAcademico"
                    android:layout_width="match_parent"
                    android:layout_height="58dp"
                    android:text="✨  Centro académico"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:gravity="center_vertical|start"
                    android:paddingStart="22dp"
                    android:background="@drawable/bg_button_nexa"
                    android:elevation="8dp"
                    android:layout_marginBottom="12dp"/>

                <Button
                    android:id="@+id/btnEspacios"
                    android:layout_width="match_parent"
                    android:layout_height="58dp"
                    android:text="📍  Espacios educativos cercanos"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:gravity="center_vertical|start"
                    android:paddingStart="22dp"
                    android:background="@drawable/bg_button_nexa_secondary"
                    android:elevation="6dp"
                    android:layout_marginBottom="12dp"/>

                <Button
                    android:id="@+id/btnGestionarActividades"
                    android:layout_width="match_parent"
                    android:layout_height="58dp"
                    android:text="📝  Gestionar actividades"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:gravity="center_vertical|start"
                    android:paddingStart="22dp"
                    android:background="@drawable/bg_button_nexa_secondary"
                    android:elevation="6dp"
                    android:layout_marginBottom="12dp"
                    android:visibility="gone"/>

                <Button
                    android:id="@+id/btnCalificarActividades"
                    android:layout_width="match_parent"
                    android:layout_height="58dp"
                    android:text="✅  Calificar actividades"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:gravity="center_vertical|start"
                    android:paddingStart="22dp"
                    android:background="@drawable/bg_button_nexa_secondary"
                    android:elevation="6dp"
                    android:layout_marginBottom="12dp"
                    android:visibility="gone"/>

                <Button
                    android:id="@+id/btnCertificados"
                    android:layout_width="match_parent"
                    android:layout_height="58dp"
                    android:text="🏆  Mis certificados"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:gravity="center_vertical|start"
                    android:paddingStart="22dp"
                    android:background="@drawable/bg_button_nexa_secondary"
                    android:elevation="6dp"
                    android:layout_marginBottom="12dp"
                    android:visibility="gone"/>

                <Button
                    android:id="@+id/btnBuscarUsuario"
                    android:layout_width="match_parent"
                    android:layout_height="58dp"
                    android:text="👤  Administración de usuarios"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:gravity="center_vertical|start"
                    android:paddingStart="22dp"
                    android:background="@drawable/bg_button_nexa_secondary"
                    android:elevation="6dp"
                    android:layout_marginBottom="12dp"
                    android:visibility="gone"/>

            </LinearLayout>

            <Button
                android:id="@+id/btnCerrarSesion"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:text="Cerrar sesión"
                android:textAllCaps="false"
                android:textColor="#D8D5E6"
                android:textSize="14sp"
                android:background="@drawable/bg_button_nexa_secondary"
                android:layout_marginTop="20dp"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="NexaLearn • Formación inteligente"
                android:textColor="#77738D"
                android:textSize="12sp"
                android:gravity="center"
                android:layout_marginTop="22dp"/>

        </LinearLayout>

    </ScrollView>

</FrameLayout>