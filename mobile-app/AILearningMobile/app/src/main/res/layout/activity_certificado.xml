<?xml version="1.0" encoding="utf-8"?>

<LinearLayout

    xmlns:android="http://schemas.android.com/apk/res/android"

    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp"

    >

    <TextView

        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Mis certificados"

        android:textSize="26sp"
        android:textStyle="bold"
        android:layout_marginBottom="8dp"

        />

    <TextView

        android:id="@+id/txtEstadoCertificados"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"

        android:text="Consulta tus certificados obtenidos."
        android:textSize="15sp"
        android:layout_marginBottom="16dp"

        />

    <ScrollView

        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"

        >

        <LinearLayout

            android:id="@+id/contenedorCertificados"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"

            >

            <TextView

                android:id="@+id/txtResultadoCertificado"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Tus certificados aparecerán aquí."
                android:textSize="16sp"
                android:layout_marginBottom="16dp"

                />

        </LinearLayout>

    </ScrollView>

    <Button

        android:id="@+id/btnGenerarCertificado"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"

        android:text="Generar certificado"
        android:textAllCaps="false"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="12dp"

        />

</LinearLayout>