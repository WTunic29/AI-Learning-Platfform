<?xml version="1.0" encoding="utf-8"?>

<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <co.edu.unipiloto.ailearningmobile.AnimatedBackgroundView
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:paddingTop="40dp"
            android:paddingBottom="40dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="NEXALEARN"
                android:textColor="#B9AAFF"
                android:textStyle="bold"
                android:textSize="13sp"
                android:letterSpacing="0.22"
                android:layout_marginBottom="10dp"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Tu aprendizaje,&#10;en otro nivel."
                android:textColor="#FFFFFF"
                android:textSize="34sp"
                android:textStyle="bold"
                android:gravity="center"
                android:lineSpacingExtra="2dp"
                android:layout_marginBottom="8dp"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Aprende, avanza y conecta."
                android:textColor="#B8B5CB"
                android:textSize="15sp"
                android:gravity="center"
                android:layout_marginBottom="30dp"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_login_card_nexa"
                android:elevation="18dp"
                android:padding="24dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Bienvenido"
                    android:textColor="#FFFFFF"
                    android:textSize="25sp"
                    android:textStyle="bold"
                    android:gravity="center"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Ingresa a tu cuenta de NexaLearn"
                    android:textColor="#ABA8BE"
                    android:textSize="14sp"
                    android:gravity="center"
                    android:layout_marginTop="5dp"
                    android:layout_marginBottom="24dp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Correo electr&#243;nico"
                    android:textColor="#D9D6E5"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:layout_marginStart="4dp"
                    android:layout_marginBottom="7dp"/>

                <EditText
                    android:id="@+id/editCorreo"
                    android:layout_width="match_parent"
                    android:layout_height="58dp"
                    android:hint="nombre@correo.com"
                    android:inputType="textEmailAddress"
                    android:singleLine="true"
                    android:textColor="#FFFFFF"
                    android:textColorHint="#77758A"
                    android:textSize="15sp"
                    android:background="@drawable/bg_input_nexa"
                    android:paddingStart="18dp"
                    android:paddingEnd="18dp"
                    android:layout_marginBottom="18dp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Contrase&#241;a"
                    android:textColor="#D9D6E5"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:layout_marginStart="4dp"
                    android:layout_marginBottom="7dp"/>

                <EditText
                    android:id="@+id/editPassword"
                    android:layout_width="match_parent"
                    android:layout_height="58dp"
                    android:hint="********"
                    android:inputType="textPassword"
                    android:singleLine="true"
                    android:textColor="#FFFFFF"
                    android:textColorHint="#77758A"
                    android:textSize="17sp"
                    android:background="@drawable/bg_input_nexa"
                    android:paddingStart="18dp"
                    android:paddingEnd="18dp"
                    android:layout_marginBottom="22dp"/>

                <Button
                    android:id="@+id/btnLogin"
                    android:layout_width="match_parent"
                    android:layout_height="58dp"
                    android:text="Iniciar sesi&#243;n  &#8594;"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:background="@drawable/bg_button_nexa"
                    android:elevation="8dp"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Accede a cursos, actividades, progreso y mucho m&#225;s."
                    android:textColor="#77758B"
                    android:textSize="12sp"
                    android:gravity="center"
                    android:layout_marginTop="17dp"/>

                <TextView
                    android:id="@+id/tvOlvidePassword"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="&#191;Olvidaste tu contrase&#241;a?"
                    android:textColor="#C8C4D8"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:gravity="center"
                    android:paddingTop="18dp"
                    android:paddingBottom="8dp"/>

                <TextView
                    android:id="@+id/tvCrearCuenta"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="&#191;A&#250;n no tienes cuenta?  Crear cuenta"
                    android:textColor="#9D89FF"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:gravity="center"
                    android:paddingTop="8dp"
                    android:paddingBottom="8dp"/>

            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Formaci&#243;n inteligente &#8226; NexaLearn"
                android:textColor="#67647B"
                android:textSize="11sp"
                android:gravity="center"
                android:layout_marginTop="25dp"/>

        </LinearLayout>

    </ScrollView>

</FrameLayout>