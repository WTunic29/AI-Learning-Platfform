<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F8FC">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Mis cursos"
            android:textSize="30sp"
            android:textStyle="bold"
            android:textColor="#1A2B49"
            android:layout_marginTop="24dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Consulta tu avance y los cursos que ya finalizaste."
            android:textSize="16sp"
            android:textColor="#5A6575"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="28dp" />

        <TextView
            android:id="@+id/txtTituloFinalizados"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Cursos finalizados"
            android:textStyle="bold"
            android:textSize="20sp"
            android:textColor="#1A2B49"
            android:layout_marginBottom="12dp" />

        <LinearLayout
            android:id="@+id/contenedorFinalizados"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <TextView
            android:id="@+id/txtTituloProgreso"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="En progreso"
            android:textStyle="bold"
            android:textSize="20sp"
            android:textColor="#1A2B49"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="12dp" />

        <LinearLayout
            android:id="@+id/contenedorEnProgreso"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

    </LinearLayout>

</ScrollView>