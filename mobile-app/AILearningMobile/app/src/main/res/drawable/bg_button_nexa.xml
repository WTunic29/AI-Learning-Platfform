<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <item android:state_pressed="true">
        <shape android:shape="rectangle">

            <corners android:radius="20dp"/>

            <gradient
                android:angle="0"
                android:startColor="#6849E8"
                android:endColor="#445CE8"/>

            <padding
                android:left="18dp"
                android:right="18dp"
                android:top="8dp"
                android:bottom="8dp"/>

        </shape>
    </item>

    <item>
        <shape android:shape="rectangle">

            <corners android:radius="20dp"/>

            <gradient
                android:angle="0"
                android:startColor="#7C5CFF"
                android:centerColor="#6650E8"
                android:endColor="#4C6FFF"/>

            <stroke
                android:width="1dp"
                android:color="#55FFFFFF"/>

            <padding
                android:left="18dp"
                android:right="18dp"
                android:top="8dp"
                android:bottom="8dp"/>

        </shape>
    </item>

</selector>