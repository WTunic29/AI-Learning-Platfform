<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <item android:state_focused="true">
        <shape android:shape="rectangle">

            <corners android:radius="18dp"/>

            <solid android:color="#201C2440"/>

            <stroke
                android:width="2dp"
                android:color="#8B72FF"/>

            <padding
                android:left="18dp"
                android:right="18dp"
                android:top="4dp"
                android:bottom="4dp"/>

        </shape>
    </item>

    <item>
        <shape android:shape="rectangle">

            <corners android:radius="18dp"/>

            <solid android:color="#17172432"/>

            <stroke
                android:width="1dp"
                android:color="#44FFFFFF"/>

            <padding
                android:left="18dp"
                android:right="18dp"
                android:top="4dp"
                android:bottom="4dp"/>

        </shape>
    </item>

</selector>